    },
    {
      "name": "Thông báo",
      "url": "/?screen=notifications",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Thêm sự kiện",
      "url": "/?screen=calendar&action=create",
